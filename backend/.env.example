# Environment configuration
# Copy this file to .env and fill in your values

# API Configuration
DEBUG=True
API_TITLE=LegalIntel AI API
API_VERSION=1.0.0

# Server
HOST=0.0.0.0
PORT=8000

# OpenAI Configuration
LLM_PROVIDER=auto
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4

# Google Gemini Configuration (free tier friendly)
GEMINI_API_KEY=AIza-your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash

# Apify Evidence Collection
APIFY_API_TOKEN=apify_api_your-token-here
APIFY_SEARCH_ACTOR_ID=apify/google-search-scraper
APIFY_MAX_RESULTS=5

# Zynd AI Agent Registry
ZYND_ENABLED=true
ZYND_REGISTRY_URL=https://zns01.zynd.ai
ZYND_AGENT_NAME=legalintel-investigator
ZYND_AGENT_URL=http://localhost:8000

# Superplane Workflow
SUPERPLANE_ENABLED=true
SUPERPLANE_CANVAS_NAME=LegalIntel Agent Review Pipeline

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=52428800
